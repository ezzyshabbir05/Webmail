                    run_container_cli alias list
                elif [ "${ALIAS_OPT}" = "2" ]; then
                    read -rp "Enter source address (e.g. info@${domain} or @${domain} for catch-all): " SRC_ALIAS
                    read -rp "Enter destination account email: " DST_ALIAS
                    if [ -n "${SRC_ALIAS}" ] && [ -n "${DST_ALIAS}" ]; then
                        run_container_cli alias add "${SRC_ALIAS}" "${DST_ALIAS}"
                    fi
                elif [ "${ALIAS_OPT}" = "3" ]; then
                    read -rp "Enter source address to remove: " REM_ALIAS
                    [ -n "${REM_ALIAS}" ] && run_container_cli alias remove "${REM_ALIAS}"
                fi
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            9)
                echo ""
                echo -e "${BOLD}${CYAN}=== View / Export DKIM Keys ===${NC}"
                read -rp "Enter domain [${domain}]: " DKIM_DOM
                DKIM_DOM="${DKIM_DOM:-$domain}"
                read -rp "Enter DKIM selector [mail]: " DKIM_SEL
                DKIM_SEL="${DKIM_SEL:-mail}"
                run_container_cli dkim export "${DKIM_DOM}" --selector "${DKIM_SEL}"
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            10)
                echo ""
                echo -e "${BOLD}${CYAN}=== SSL/TLS Certificate Management ===${NC}"
                echo "1) Show certificate status & expiration"
                echo "2) Request / Renew Let's Encrypt certificate"
                read -rp "Select option [1]: " CERT_OPT
