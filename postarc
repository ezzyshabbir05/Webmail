                if [ "${CERT_OPT}" = "1" ]; then
                    manage_cert status "${host_name}"
                else
                    manage_cert request "${host_name}"
                fi
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            11)
                echo -e "${CYAN}Streaming live logs (Press Ctrl+C to return to menu)...${NC}"
                ${COMPOSE_CMD} -f "${COMPOSE_FILE}" logs -f --tail=100 postarc || true
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            12)
                echo -e "${CYAN}Restarting Postarc services...${NC}"
                ${COMPOSE_CMD} -f "${COMPOSE_FILE}" up -d --force-recreate
                sleep 2
                sync_db_password
                echo -e "${GREEN}Services restarted successfully.${NC}"
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            13)
                echo -e "${CYAN}Updating Postarc from Git repository...${NC}"
                git pull origin main
                echo -e "${CYAN}Rebuilding image...${NC}"
                ${COMPOSE_CMD} -f "${COMPOSE_FILE}" build
                echo -e "${CYAN}Reloading services...${NC}"
                ${COMPOSE_CMD} -f "${COMPOSE_FILE}" up -d
                install_host_symlink
                echo -e "${GREEN}Postarc is updated and running the latest release!${NC}"
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            14)
                echo ""
                run_backup
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            15)
                echo ""
                run_restore
                echo ""
                read -rp "Press Enter to return to menu..." _
                ;;
            0|q|exit)
                echo -e "${GREEN}Goodbye!${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid option.${NC}"
                sleep 1
                ;;
        esac
    done
}

# ==============================================================================
# CLI Entry Point & Subcommand Dispatcher
# ==============================================================================

CMD="${1:-}"

if [ -z "${CMD}" ]; then
    if [ ! -f .env ]; then
        run_setup_wizard
    elif [ -t 0 ]; then
        run_interactive_menu
    else
        print_usage
    fi
    exit 0
fi

shift || true

case "${CMD}" in
    setup)
        run_setup_wizard
        ;;
    menu)
        run_interactive_menu
        ;;
    info)
        print_client_info
        ;;
    doctor)
        run_container_cli doctor "$@"
        ;;
    backup)
        run_backup "$@"
        ;;
    restore)
        run_restore "$@"
        ;;
    user|domain|alias|dkim)
        run_container_cli "${CMD}" "$@"
        ;;
    cert)
        manage_cert "$@"
        ;;
    logs)
        ensure_docker
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" logs -f postarc "$@"
        ;;
    status)
        ensure_docker
        echo -e "${BOLD}${CYAN}Postarc Container Status:${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" ps
        echo ""
        echo -e "${BOLD}${CYAN}Active Listening Ports:${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 25 2>/dev/null && echo "  - Port 25:   SMTP Inbound MTA" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 143 2>/dev/null && echo "  - Port 143:  IMAP (STARTTLS)" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 465 2>/dev/null && echo "  - Port 465:  SMTPS (Implicit TLS)" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 587 2>/dev/null && echo "  - Port 587:  SMTP Submission" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 993 2>/dev/null && echo "  - Port 993:  IMAPS (Implicit TLS)" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc 8080 2>/dev/null && echo "  - Port 8080: JMAP / HTTP API" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port webmail 3000 2>/dev/null && echo "  - Port 3000: Webmail UI" || true
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" port postarc-webmail 3000 2>/dev/null && echo "  - Port 3000: Webmail UI" || true
        ;;
    start)
        ensure_docker
        echo -e "${CYAN}Starting Postarc mailserver services...${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" up -d
        sleep 2
        sync_db_password
        echo -e "${GREEN}Postarc is running.${NC}"
        ;;
    stop)
        ensure_docker
        echo -e "${YELLOW}Stopping Postarc mailserver services...${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" down
        echo -e "${GREEN}Postarc stopped.${NC}"
        ;;
    restart)
        ensure_docker
        echo -e "${CYAN}Restarting Postarc mailserver services...${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" up -d --force-recreate
        sleep 2
        sync_db_password
        echo -e "${GREEN}Postarc restarted successfully.${NC}"
        ;;
    update)
        ensure_docker
        echo -e "${CYAN}Updating Postarc from Git...${NC}"
        git pull origin main
        echo -e "${CYAN}Rebuilding image with updated source...${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" build
        echo -e "${CYAN}Recreating containers with zero data loss...${NC}"
        ${COMPOSE_CMD} -f "${COMPOSE_FILE}" up -d
        install_host_symlink
        echo -e "${GREEN}Postarc updated to latest release successfully!${NC}"
        ;;
    help|--help|-h)
        print_usage
        ;;
    *)
        echo -e "${RED}Unknown command: '${CMD}'${NC}"
        echo "Run 'postarc help' for available commands."
        exit 1
        ;;
esac
