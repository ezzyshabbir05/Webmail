{
  "name": "postarc",
  "version": "1.0.0",
  "description": "Postarc - Unified Mail Ecosystem (Postarc Mailserver & Postarc Webmail)",
  "private": true,
  "workspaces": [
    "webmail"
  ],
  "scripts": {
    "dev": "npm --prefix webmail run dev",
    "build": "npm --prefix webmail run build",
    "start": "npm --prefix webmail run start",
    "lint": "npm --prefix webmail run lint",
    "doctor": "npm --prefix webmail run doctor",
    "setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1",
    "setup:sh": "bash ./scripts/setup.sh",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d"
  }
}
