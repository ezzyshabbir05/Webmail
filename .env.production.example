# ==============================================================================
# Postarc Production Environment Configuration
# Copy this file to .env on your VPS before running setup:
#   cp .env.production.example .env
# ==============================================================================

# Primary Domain & Hostname
MAIL_DOMAIN=agilique.com
MAIL_HOSTNAME=mail.agilique.com
ACME_EMAIL=admin@agilique.com

# PostgreSQL 17 Credentials
POSTGRES_DB=postarc
POSTGRES_USER=postarc
POSTGRES_PASSWORD=replace_with_strong_random_db_password_123!

# Security & JWT Tokens (Must be a strong secret)
JWT_SECRET=replace_with_64_char_cryptographic_random_secret_token_key!

# Storage Configuration
# Choose 's3' for Cloudflare R2 / AWS S3, or 'fs' for local filesystem
STORAGE_BACKEND=s3
R2_BUCKET=postarc-mail
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
