# ==============================================================================
# Postarc Production Environment Configuration
# Either run `bash scripts/setup-vps.sh` for guided interactive setup,
# or copy this file to .env and populate your values manually:
#   cp .env.production.example .env
# ==============================================================================

# Primary Domain & Hostname
MAIL_DOMAIN=yourdomain.com
MAIL_HOSTNAME=mail.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# SSL/TLS Certificate Paths (Auto-discovered or explicitly configured)
TLS_CERT_PATH=/etc/letsencrypt/live/${MAIL_HOSTNAME}/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/${MAIL_HOSTNAME}/privkey.pem

# Initial Postarc Admin Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_admin_password_here

# PostgreSQL 17 Credentials
POSTGRES_DB=postarc
POSTGRES_USER=postarc
POSTGRES_PASSWORD=replace_with_strong_random_db_password_123!

# Security & JWT Tokens (Must be a strong secret)
JWT_SECRET=replace_with_64_char_cryptographic_random_secret_token_key!

# Storage Configuration
# Choose 's3' for Cloudflare R2 / AWS S3, or 'fs' for local filesystem
STORAGE_BACKEND=fs
# If using Cloudflare R2 / S3 (STORAGE_BACKEND=s3):
R2_BUCKET=postarc-mail
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
